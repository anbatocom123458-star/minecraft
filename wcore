# ─── HỆ THỐNG ĐO RAM TỐI ƯU ───
def get_system_ram_usage():
    try:
        import psutil
        mem = psutil.virtual_memory()
        used_gb = mem.used / (1024 ** 3)
        total_gb = mem.total / (1024 ** 3)
        return f"{used_gb:.1f}GB / {total_gb:.1f}GB ({mem.percent}%)"
    except ImportError:
        try:
            with open('/proc/meminfo', 'r') as f:
                lines = f.readlines()
            mem_total = int([x for x in lines if 'MemTotal' in x][0].split()[1]) / (1024 ** 2)
            mem_free = int([x for x in lines if 'MemAvailable' in x][0].split()[1]) / (1024 ** 2)
            mem_used = mem_total - mem_free
            percent = int((mem_used / mem_total) * 100)
            return f"{mem_used:.1f}GB / {mem_total:.1f}GB ({percent}%)"
        except Exception:
            return "RAM: N/A"


