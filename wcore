def cmd_read(arg):
    if not arg:
        flash_err("Thiếu đường dẫn. Cú pháp: /read <file>")
        return
    path = resolve_path(arg)
    if not path.exists():
        flash_err(f"Không tìm thấy file: {path}")
        return
    if path.is_dir():
        flash_err(f"{path} là thư mục, dùng /ls thay vì /read")
        return
    try:
        text, size, truncated = spinner_run("Đang đọc file", read_file_content, path)
    except Exception as e:
        flash_err(f"Lỗi đọc file: {e}")
        return

    lang = guess_lang(str(path))
    syntax = Syntax(text, lang, theme="monokai", line_numbers=True, word_wrap=False)
    title = f"[bold {C_ORANGE}]📄 {path.name}[/bold {C_ORANGE}]  [dim]({size} bytes, {lang})[/dim]"
    console.print(Panel(syntax, title=title, border_style=C_BLUE, box=ROUNDED))
    if truncated:
        flash_warn(f"File quá lớn, chỉ hiển thị 200KB đầu tiên.")
    flash_ok(f"Đã đọc {path}")


def multiline_editor():
    console.print(f"[dim {C_GRAY}]Nhập nội dung nhiều dòng. Gõ [bold {C_ORANGE}]EOF[/bold {C_ORANGE}] trên một dòng riêng để kết thúc.[/dim {C_GRAY}]")
    lines = []
    while True:
        try:
            line = console.input(f"[{C_DARKGRAY}]{len(lines)+1:>3}│[/{C_DARKGRAY}] ")
        except (EOFError, KeyboardInterrupt):
            console.print()
            return None
        if line.strip() == "EOF":
            break
        lines.append(line)
    return "\n".join(lines) + ("\n" if lines else "")


def cmd_write(arg):
    if not arg:
        flash_err("Thiếu đường dẫn. Cú pháp: /write <file>")
        return
    path = resolve_path(arg)
    if path.exists() and path.is_dir():
        flash_err(f"{path} là thư mục.")
        return
    if path.exists():
        confirm = console.input(f"[{C_YELLOW}]⚠ File đã tồn tại, ghi đè? (y/N): [/{C_YELLOW}]").strip().lower()
        if confirm != 'y':
            flash_warn("Đã hủy.")
            return
    content = multiline_editor()
    if content is None:
        flash_warn("Đã hủy.")
        return
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(content, encoding='utf-8')
    except Exception as e:
        flash_err(f"Lỗi ghi file: {e}")
        return
    flash_ok(f"Đã lưu {path} ({len(content)} bytes)")


def cmd_append(arg):
    if not arg:
        flash_err("Thiếu đường dẫn. Cú pháp: /append <file>")
        return
    path = resolve_path(arg)
    if path.is_dir():
        flash_err(f"{path} là thư mục.")
        return
    content = multiline_editor()
    if content is None:
        flash_warn("Đã hủy.")
        return
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        with open(path, 'a', encoding='utf-8') as f:
            f.write(content)
    except Exception as e:
        flash_err(f"Lỗi nối file: {e}")
        return
    flash_ok(f"Đã nối thêm {len(content)} bytes vào {path}")


def cmd_rm(arg):
    if not arg:
        flash_err("Thiếu đường dẫn. Cú pháp: /rm <file|thư mục>")
        return
    path = resolve_path(arg)
    if not path.exists():
        flash_err(f"Không tìm thấy: {path}")
        return
    kind = "thư mục" if path.is_dir() else "file"
    confirm = console.input(f"[{C_RED}]⚠ Xoá {kind} '{path}'? Không thể hoàn tác! (y/N): [/{C_RED}]").strip().lower()
    if confirm != 'y':
        flash_warn("Đã hủy.")
        return
    try:
        if path.is_dir():
            shutil.rmtree(path)
        else:
            path.unlink()
    except Exception as e:
        flash_err(f"Lỗi xoá: {e}")
        return
    flash_ok(f"Đã xoá {path}")


def build_tree(path: Path, tree: Tree, depth=0, max_depth=3, max_entries=200):
    if depth >= max_depth:
        return
    try:
        entries = sorted(path.iterdir(), key=lambda p: (p.is_file(), p.name.lower()))
    except PermissionError:
        return
    count = 0
    for entry in entries:
        if entry.name.startswith('.') and entry.name not in ('.env',):
            continue
        if entry.name in ('node_modules', '__pycache__', '.git', 'venv'):
            continue
        count += 1
        if count > max_entries:
            tree.add(f"[dim]... còn nhiều hơn[/dim]")
            break
        if entry.is_dir():
            branch = tree.add(f"[bold {C_BLUE}]📁 {entry.name}[/bold {C_BLUE}]")
            build_tree(entry, branch, depth + 1, max_depth, max_entries)
        else:
            branch_color = C_WHITE
            tree.add(f"[{branch_color}]📄 {entry.name}[/{branch_color}]")


def cmd_ls(arg):
    target = resolve_path(arg) if arg else Path(CWD)
    if not target.exists():
        flash_err(f"Không tìm thấy: {target}")
        return
    if target.is_file():
        cmd_read(arg)
        return
    tree = Tree(f"[bold {C_ORANGE}]📁 {target}[/bold {C_ORANGE}]")
    spinner_run("Đang quét thư mục", build_tree, target, tree)
    console.print(Panel(tree, border_style=C_ORANGE2, box=ROUNDED))


def cmd_find(arg):
    if not arg:
        flash_err("Thiếu pattern. Cú pháp: /find <pattern> (vd: *.py)")
        return
    root = Path(CWD)
    matches = []
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [d for d in dirnames if d not in ('node_modules', '__pycache__', '.git', 'venv') and not d.startswith('.')]
        for fname in filenames:
            if fnmatch.fnmatch(fname, arg):
                matches.append(str(Path(dirpath) / fname))
        if len(matches) >= 500:
            break
    if not matches:
        flash_warn(f"Không tìm thấy file khớp '{arg}'")
        return
    t = Text()
    for m in matches[:100]:
        rel = os.path.relpath(m, root)
        t.append("• ", style=C_ORANGE)
        t.append(rel, style=C_WHITE)
        t.append("\n")
    console.print(Panel(t, title=f"[bold {C_ORANGE}]🔎 {len(matches)} kết quả cho '{arg}'[/bold {C_ORANGE}]", border_style=C_GREEN, box=ROUNDED))


def cmd_cwd(arg):
    global CWD
    if not arg:
        console.print(f"[bold {C_ORANGE}]📁[/bold {C_ORANGE}] {CWD}")
        return
    path = resolve_path(arg)
    if not path.exists() or not path.is_dir():
        flash_err(f"Không tìm thấy thư mục: {path}")
        return
    CWD = str(path)
    os.chdir(CWD)
    flash_ok(f"Đã chuyển tới {CWD}")


def cmd_run(arg):
    if not arg:
        flash_err("Thiếu lệnh. Cú pháp: /run <lệnh shell>")
        return
    console.print(Rule(f"[bold {C_ORANGE}]▶ RUNNING[/bold {C_ORANGE}]", style=C_ORANGE2))
    console.print(f"[dim {C_GRAY}]$ {arg}[/dim {C_GRAY}]")
    t0 = time.time()
    try:
        with console.status(f"[bold {C_ORANGE}]⚙  Đang thực thi...[/bold {C_ORANGE}]", spinner="dots12"):
            proc = subprocess.run(
                arg, shell=True, cwd=CWD,
                capture_output=True, text=True, timeout=300
            )
    except subprocess.TimeoutExpired:
        flash_err("Lệnh chạy quá 300s, đã bị hủy.")
        return
    except Exception as e:
        flash_err(f"Lỗi thực thi: {e}")
        return
    elapsed = time.time() - t0

    if proc.stdout:
        console.print(Panel(proc.stdout.rstrip(), title="[bold]stdout[/bold]", border_style=C_GREEN, box=ROUNDED))
    if proc.stderr:
        console.print(Panel(proc.stderr.rstrip(), title="[bold]stderr[/bold]", border_style=C_RED, box=ROUNDED))
    if not proc.stdout and not proc.stderr:
        console.print(f"[dim]{C_GRAY}(không có output)[/dim]")

    if proc.returncode == 0:
        flash_ok(f"Hoàn thành trong {elapsed:.2f}s (exit code 0)")
    else:
        flash_err(f"Thoát với exit code {proc.returncode} sau {elapsed:.2f}s")


COMMANDS = {
    '/help': cmd_help,
    '/info': cmd_info,
}

COMMANDS_WITH_ARG = {
    '/read': cmd_read,
    '/cat': cmd_read,
    '/write': cmd_write,
    '/append': cmd_append,
    '/rm': cmd_rm,
    '/del': cmd_rm,
    '/ls': cmd_ls,
    '/find': cmd_find,
    '/cwd': cmd_cwd,
    '/cd': cmd_cwd,
    '/run': cmd_run,
    '/exec': cmd_run,
}


def handle_command(raw: str):
    parts = raw.strip().split(maxsplit=1)
    cmd = parts[0].lower()
    arg = parts[1] if len(parts) > 1 else ""

    if cmd in ('/exit', '/quit'):
        console.print(f"\n[bold {C_ORANGE}]👋 Cảm ơn bạn đã sử dụng wcore-X![/bold {C_ORANGE}]")
        sys.exit(0)
    elif cmd == '/clear':
        console.clear()
        return 'clear'
    elif cmd in COMMANDS:
        COMMANDS[cmd]()
    elif cmd in COMMANDS_WITH_ARG:
        COMMANDS_WITH_ARG[cmd](arg.strip())
    else:
        flash_err(f"Không nhận diện lệnh '{cmd}'. Gõ /help để xem danh sách.")
    console.print(f"[dim]{'─' * min(shutil.get_terminal_size().columns, 65)}[/dim]\n")
    return None


# ─── MAIN LOOP ───
def main():
    console.clear()
    render_welcome()
    console.print(f"\n[dim]Gõ /help để xem danh sách lệnh. Gõ /exit để thoát.[/dim]\n")

    while True:
        try:
            user_inp = console.input(f"[bold {C_ORANGE}]👤 {os.path.basename(CWD)} ❯ [/bold {C_ORANGE}]").strip()
            if not user_inp:
                continue

            if user_inp.startswith('/'):
                result = handle_command(user_inp)
                if result == 'clear':
                    render_welcome()
                continue

            # Không phải lệnh -> chỉ là note, không thực thi
            console.print(f"[dim {C_GRAY}]· note: \"{user_inp}\" (không bắt đầu bằng / nên không thực thi gì)[/dim {C_GRAY}]\n")

        except KeyboardInterrupt:
            console.print(f"\n[bold {C_ORANGE}]👋 Tạm biệt![/bold {C_ORANGE}]")
            break
        except EOFError:
            break


if __name__ == "__main__":
    main()
