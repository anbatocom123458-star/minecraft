# ─── MAIN ENTRYPOINT ───
def main():
    ensure_local_ai_service()
    render_welcome()

    while True:
        try:
            user_inp = console.input(f"[bold {C_ORANGE}]👤 {os.path.basename(CWD)} ❯ [/bold {C_ORANGE}]").strip()
            if not user_inp:
                continue

            parse_and_execute_intent(user_inp)
            console.print(f"[dim]{'─' * min(shutil.get_terminal_size().columns, 65)}[/dim]\n")

        except KeyboardInterrupt:
            console.print(f"\n[bold {C_ORANGE}]👋 Tạm biệt![/bold {C_ORANGE}]")
            break
        except EOFError:
            break


if __name__ == "__main__":
    main()
