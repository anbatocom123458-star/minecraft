# ─── HỆ THỐNG ROOT AI AUTO-EXECUTION (TỰ TẠO FILE, NHÚNG CODE, CHẠY LỆNH) ───
def execute_root_ai_actions(ai_response: str):
    lines = ai_response.split('\n')
    in_code_block = False
    current_code = []
    current_lang = ""
    target_filename = "auto_script.py"

    for line in lines:
        if line.startswith("```"):
            if in_code_block:
                in_code_block = False
                execute_extracted_payload(current_lang, "\n".join(current_code), target_filename)
                current_code = []
            else:
                in_code_block = True
                parts = line.strip("`").split()
                current_lang = parts[0] if parts else "python"
                if len(parts) > 1:
                    target_filename = parts[1]
            continue

        if in_code_block:
            current_code.append(line)


def execute_extracted_payload(lang: str, code: str, filename: str):
    console.print(f"\n[bold yellow]⚡ [ROOT AUTO-EXEC] Đang xử lý khối mã nguồn ({lang})...[/bold yellow]")
    
    if lang in ['python', 'sh', 'bash', 'html', 'javascript', 'txt', 'json']:
        if not filename or filename == "auto_script.py":
            ext_map = {'python': '.py', 'sh': '.sh', 'bash': '.sh', 'html': '.html', 'javascript': '.js', 'txt': '.txt', 'json': '.json'}
            filename = f"root_output{ext_map.get(lang, '.txt')}"
        
        try:
            p = Path(CWD) / filename
            p.write_text(code, encoding='utf-8')
            flash_ok(f"Đã tạo & nhúng file mã nguồn thành công: {filename}")
        except Exception as e:
            flash_err(f"Lỗi tạo file: {e}")

    if lang in ['python', 'sh', 'bash']:
        confirm = console.input(f"[bold cyan]Quyền Root: Bạn có muốn chạy lệnh file '{filename}' ngay không? (y/n): [/bold cyan]").strip().lower()
        if confirm == 'y':
            console.print(Rule(f"[bold {RAINBOW_COLORS[1]}]▶ ROOT EXECUTION RUNNING[/bold {RAINBOW_COLORS[1]}]"))
            try:
                cmd = f"python3 {filename}" if lang == 'python' else f"bash {filename}"
                proc = subprocess.run(cmd, shell=True, cwd=CWD, capture_output=True, text=True, timeout=60)
                if proc.stdout:
                    console.print(Panel(proc.stdout.rstrip(), title="stdout (Root)", border_style=C_GREEN, box=ROUNDED))
                if proc.stderr:
                    console.print(Panel(proc.stderr.rstrip(), title="stderr (Root)", border_style=C_RED, box=ROUNDED))
                flash_ok("Thực thi hoàn tất!")
            except Exception as e:
                flash_err(f"Lỗi thực thi: {e}")


# ─── LOCAL STREAMING ENGINE VỚI ĐO RAM & TOKEN/S THỜI GIAN THỰC ───
def call_ollama_stream(prompt: str):
    url = f"{OLLAMA_LOCAL_URL}/api/chat"
    payload = {
        "model": CURRENT_MODEL,
        "messages": [{"role": "user", "content": prompt}],
        "stream": True
    }
    data = json.dumps(payload).encode('utf-8')
    req = urllib.request.Request(url, data=data, headers={'Content-Type': 'application/json'})

    full_text = ""
    token_count = 0
    start_time = time.time()

    console.print(Rule(f"[bold {RAINBOW_COLORS[4]}]🤖 Local AI ({CURRENT_MODEL})[/bold {RAINBOW_COLORS[4]}]"))

    try:
        with Live(console=console, refresh_per_second=15) as live:
            with urllib.request.urlopen(req, timeout=120) as response:
                for line in response:
                    if line:
                        res_json = json.loads(line.decode('utf-8'))
                        chunk = res_json.get("message", {}).get("content", "")
                        full_text += chunk
                        
                        token_count += max(1, len(chunk) // 3)
                        elapsed = max(0.001, time.time() - start_time)
                        tps = token_count / elapsed
                        ram_now = get_system_ram_usage()

                        status_bar = f"\n\n[dim cyan]⚡ {token_count} tokens │ ⏱️ {elapsed:.1f}s │ 🚀 {tps:.1f} t/s │ 🧠 RAM: {ram_now}[/dim cyan]"
                        live.update(Panel(Markdown(full_text + status_bar), border_style=RAINBOW_COLORS[4], box=ROUNDED))
        
        execute_root_ai_actions(full_text)

    except Exception as e:
        flash_err(f"Lỗi Ollama Local: {e}. Vui lòng đảm bảo dịch vụ 'ollama serve' đang chạy.")


# ─── INTENT PARSER ───
def parse_and_execute_intent(user_inp: str):
    inp = user_inp.strip()
    low = inp.lower()

    if low in ('exit', 'quit', 'thoát', 'dừng', '/exit'):
        console.print(f"\n[bold {RAINBOW_COLORS[1]}]👋 Tạm biệt người quản trị![/bold {RAINBOW_COLORS[1]}]")
        sys.exit(0)

    if low in ('clear', 'xoá màn hình', 'xóa màn hình', '/clear', 'cls'):
        render_welcome()
        return

    if low in ('đổi model', 'doi model', 'model', 'change model', '/model'):
        change_model_menu()
        return

    read_keywords = ['xem file', 'đọc file', 'kiểm tra file', 'mở file', 'cat ', 'read ', '/read ']
    for kw in read_keywords:
        if low.startswith(kw):
            cmd_read(inp[len(kw):].strip())
            return

    run_keywords = ['chạy lệnh', 'thực thi', 'chạy ', 'run ', 'exec ', '/run ']
    for kw in run_keywords:
        if low.startswith(kw):
            cmd_run(inp[len(kw):].strip())
            return

    if low in ('ls', 'dir', 'danh sách', 'xem thư mục', 'kiểm tra thư mục', '/ls'):
        cmd_ls('')
        return

    rm_keywords = ['xoá file', 'xóa file', 'xoá ', 'xóa ', 'rm ', '/rm ']
    for kw in rm_keywords:
        if low.startswith(kw):
            cmd_rm(inp[len(kw):].strip())
            return

    if low in ('help', 'trợ giúp', 'hướng dẫn', '/help'):
        cmd_help()
        return

    call_ollama_stream(inp)


# ─── COMMAND HANDLERS ───
def cmd_read(arg):
    if not arg:
        flash_err("Cú pháp: xem file <tên_file>")
        return
    p = Path(arg).expanduser()
    if not p.is_absolute():
        p = Path(CWD) / p
    if not p.exists():
        flash_err(f"Không tìm thấy file: {p}")
        return
    try:
        text = p.read_text(encoding='utf-8', errors='replace')
        ext = p.suffix.lower().replace('.', '') or 'text'
        syntax = Syntax(text, ext, theme="monokai", line_numbers=True)
        console.print(Panel(syntax, title=f"📄 {p.name}", border_style=RAINBOW_COLORS[3], box=ROUNDED))
    except Exception as e:
        flash_err(f"Lỗi đọc file: {e}")


def cmd_run(arg):
    if not arg:
        flash_err("Cú pháp: chạy <lệnh_shell>")
        return
    console.print(Rule(f"[bold {RAINBOW_COLORS[1]}]▶ ROOT SHELL RUNNING[/bold {RAINBOW_COLORS[1]}]"))
    try:
        proc = subprocess.run(arg, shell=True, cwd=CWD, capture_output=True, text=True, timeout=120)
        if proc.stdout:
            console.print(Panel(proc.stdout.rstrip(), title="stdout", border_style=C_GREEN, box=ROUNDED))
        if proc.stderr:
            console.print(Panel(proc.stderr.rstrip(), title="stderr", border_style=C_RED, box=ROUNDED))
        if proc.returncode == 0:
            flash_ok("Thực thi thành công")
        else:
            flash_err(f"Mã lỗi exit code {proc.returncode}")
    except Exception as e:
        flash_err(f"Lỗi: {e}")


def cmd_ls(arg):
    target = Path(arg) if arg else Path(CWD)
    if not target.exists():
        flash_err(f"Không tìm thấy: {target}")
        return
    tree = Tree(f"[bold {RAINBOW_COLORS[2]}]📁 {target.name}[/bold {RAINBOW_COLORS[2]}]")
    try:
        for p in sorted(target.iterdir()):
            if p.name.startswith('.'):
                continue
            if p.is_dir():
                tree.add(f"[bold {RAINBOW_COLORS[4]}]📁 {p.name}[/bold {RAINBOW_COLORS[4]}]")
            else:
                tree.add(f"[white]📄 {p.name}[/white]")
        console.print(Panel(tree, border_style=RAINBOW_COLORS[3], box=ROUNDED))
    except Exception as e:
        flash_err(f"Lỗi: {e}")


def cmd_rm(arg):
    if not arg:
        flash_err("Cú pháp: xoá file <tên_file>")
        return
    p = Path(arg)
    if not p.exists():
        flash_err(f"Không thấy: {p}")
        return
    try:
        if p.is_dir():
            shutil.rmtree(p)
        else:
            p.unlink()
        flash_ok(f"Đã xoá {p}")
    except Exception as e:
        flash_err(f"Lỗi xoá: {e}")


