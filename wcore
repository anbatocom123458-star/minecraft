# ─── PARTICLE SYSTEM ───
class ParticleField:
    def __init__(self, w=90, h=10, density=0.03):
        self.w, self.h = w, h
        self.stars = []
        for _ in range(int(w * h * density)):
            self.stars.append({
                'x': random.randint(0, w - 1),
                'y': random.uniform(0, h - 1),
                'c': random.choice(['·', '•', '*', '˖', '‧', '✦']),
                's': random.uniform(0.15, 0.55),
                'col': random.choice([C_GRAY, C_DARKGRAY, C_ORANGE2, C_WHITE, C_ORANGE]),
            })

    def tick(self):
        for s in self.stars:
            s['y'] += s['s']
            if s['y'] >= self.h:
                s['y'] = 0
                s['x'] = random.randint(0, self.w - 1)

    def render(self):
        grid = [[' ' for _ in range(self.w)] for _ in range(self.h)]
        cols = [[None for _ in range(self.w)] for _ in range(self.h)]
        for s in self.stars:
            y, x = int(s['y']), int(s['x'])
            if 0 <= y < self.h and 0 <= x < self.w:
                grid[y][x] = s['c']
                cols[y][x] = s['col']
        lines = []
        for y in range(self.h):
            t = Text()
            for x in range(self.w):
                t.append(grid[y][x], style=cols[y][x] or C_BG)
            lines.append(t)
        return lines


