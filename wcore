# ─── METEOR RAINBOW ENGINE (MƯỢT 30FPS) ───
class MeteorRainbowField:
    def __init__(self, w=80, h=4):
        self.w, self.h = w, h
        self.stars = [{'x': random.randint(0, w - 1), 'y': random.uniform(0, h - 1), 
                       'c': random.choice(['·', '•', '*', '✦', '✧', '★']), 
                       's': random.uniform(0.1, 0.3), 'col': random.choice(RAINBOW_COLORS)} 
                      for _ in range(25)]
        self.meteor_x, self.meteor_y = -5, random.randint(0, h - 1)

    def tick(self):
        for s in self.stars:
            s['y'] += s['s']
            if s['y'] >= self.h:
                s['y'], s['x'] = 0, random.randint(0, self.w - 1)
        self.meteor_x += 3.5
        if self.meteor_x > self.w + 12:
            self.meteor_x, self.meteor_y = -5, random.randint(0, self.h - 1)

    def render(self):
        grid = [[' ' for _ in range(self.w)] for _ in range(self.h)]
        cols = [[None for _ in range(self.w)] for _ in range(self.h)]

        for s in self.stars:
            y, x = int(s['y']), int(s['x'])
            if 0 <= y < self.h and 0 <= x < self.w:
                grid[y][x], cols[y][x] = s['c'], s['col']

        mx, my = int(self.meteor_x), int(self.meteor_y)
        for i, (color, char) in enumerate([('#ff4444', '☄'), ('#ffaa00', '≡'), ('#ffcc00', '-'), ('#4ade80', '·')]):
            tx = mx - i
            if 0 <= my < self.h and 0 <= tx < self.w:
                grid[my][tx], cols[my][tx] = char, color

        return [Text("".join(grid[y]), style=C_BG).assemble(*[(grid[y][x], Style(color=cols[y][x])) for x in range(self.w) if cols[y][x]]) for y in range(self.h)]


