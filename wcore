# ─── METEOR & STAR ANIMATION ENGINE ───
class MeteorParticleField:
    def __init__(self, w=80, h=3):
        self.w, self.h = w, h
        self.stars = []
        for _ in range(12):
            self.stars.append({
                'x': random.randint(0, w - 1),
                'y': random.uniform(0, h - 1),
                'c': random.choice(['·', '•', '*', '✦']),
                's': random.uniform(0.2, 0.5),
                'col': random.choice([C_GRAY, C_ORANGE2, C_WHITE]),
            })
        self.meteor_x = 0
        self.meteor_y = 0

    def tick(self):
        for s in self.stars:
            s['y'] += s['s']
            if s['y'] >= self.h:
                s['y'] = 0
                s['x'] = random.randint(0, self.w - 1)
        self.meteor_x = (self.meteor_x + 2) % (self.w + 10)

    def render(self):
        grid = [[' ' for _ in range(self.w)] for _ in range(self.h)]
        cols = [[None for _ in range(self.w)] for _ in range(self.h)]

        for s in self.stars:
            y, x = int(s['y']), int(s['x'])
            if 0 <= y < self.h and 0 <= x < self.w:
                grid[y][x] = s['c']
                cols[y][x] = s['col']

        # Meteor streak
        mx, my = self.meteor_x - 5, 1
        if 0 <= my < self.h and 0 <= mx < self.w:
            grid[my][mx] = '☄'
            cols[my][mx] = C_CYAN

        lines = []
        for y in range(self.h):
            t = Text()
            for x in range(self.w):
                t.append(grid[y][x], style=cols[y][x] or C_BG)
            lines.append(t)
        return lines


# ─── UI RENDERERS ───
def render_logo_frame(frame, width=80):
    t = Text()
    lines = LOGO.split('\n')
    max_line_len = max(len(l) for l in lines)
    pad = max(0, (width - max_line_len) // 2)
    for li, line in enumerate(lines):
        color = GRADIENT[(frame + li) % len(GRADIENT)]
        t.append(" " * pad + line, style=Style(color=color, bold=True))
        t.append('\n')
    sub_pad = max(0, (width - len(SUBTITLE)) // 2)
    t.append(" " * sub_pad + f"{SUBTITLE}\n", style=Style(color=C_GRAY, dim=True))
    return t


def render_logo():
    t = Text()
    for line in LOGO.split('\n'):
        t.append(line, style=Style(color=C_ORANGE, bold=True))
        t.append('\n')
    t.append(f"\n{SUBTITLE}\n", style=Style(color=C_GRAY, dim=True))
    return Align.center(t)


