    try:
        req = urllib.request.Request(f"{OLLAMA_BASE_URL}/api/tags")
        with urllib.request.urlopen(req, timeout=2):
            pass
    except Exception:
        subprocess.Popen("ollama serve > /dev/null 2>&1 &", shell=True)
        time.sleep(3)


def get_installed_ollama_models() -> list:
    """Lấy danh sách các model đã có sẵn trong Ollama local."""
    try:
        req = urllib.request.Request(f"{OLLAMA_BASE_URL}/api/tags")
        with urllib.request.urlopen(req, timeout=3) as res:
            data = json.loads(res.read().decode('utf-8'))
            return [m.get('name') for m in data.get('models', [])]
    except Exception:
        return []


# ─── METEOR & STAR ANIMATION ENGINE ───
class MeteorParticleField:
    def __init__(self, w=80, h=3):
        self.w, self.h = w, h
        self.stars = []
        for _ in range(16):
            self.stars.append({
                'x': random.randint(0, w - 1),
                'y': random.uniform(0, h - 1),
                'c': random.choice(['·', '•', '*', '✦', '✧']),
                's': random.uniform(0.1, 0.3),
                'col': random.choice([C_GRAY, C_ORANGE2, C_WHITE, C_DARKGRAY]),
            })
        self.meteor_x = -5
        self.meteor_y = random.randint(0, h - 1)

    def tick(self):
        for s in self.stars:
            s['y'] += s['s']
            if s['y'] >= self.h:
                s['y'] = 0
                s['x'] = random.randint(0, self.w - 1)
        
        self.meteor_x += 2.5
        if self.meteor_x > self.w + 10:
            self.meteor_x = -5
            self.meteor_y = random.randint(0, self.h - 1)

    def render(self):
        grid = [[' ' for _ in range(self.w)] for _ in range(self.h)]
        cols = [[None for _ in range(self.w)] for _ in range(self.h)]

        for s in self.stars:
            y, x = int(s['y']), int(s['x'])
            if 0 <= y < self.h and 0 <= x < self.w:
                grid[y][x] = s['c']
                cols[y][x] = s['col']

        mx, my = int(self.meteor_x), int(self.meteor_y)
        trail = [('☄', C_CYAN), ('≡', C_BLUE), ('-', C_BLUE), ('·', C_DARKGRAY)]
        for i, (char, color) in enumerate(trail):
            tx = mx - i
            if 0 <= my < self.h and 0 <= tx < self.w:
                grid[my][tx] = char
                cols[my][tx] = color

        lines = []
        for y in range(self.h):
            t = Text()
            for x in range(self.w):
                t.append(grid[y][x], style=cols[y][x] or C_BG)
            lines.append(t)
        return lines


# ─── UI RENDERERS ───
def render_logo_frame(frame, width=80):
    t = Text()
    lines = LOGO.split('\n')
    max_line_len = max(len(l) for l in lines)
    pad = max(0, (width - max_line_len) // 2)
    for li, line in enumerate(lines):
        color = GRADIENT[(frame + li) % len(GRADIENT)]
        t.append(" " * pad + line, style=Style(color=color, bold=True))
        t.append('\n')
    sub_pad = max(0, (width - len(SUBTITLE)) // 2)
    t.append(" " * sub_pad + f"{SUBTITLE}\n", style=Style(color=C_GRAY, dim=True))
    return t


