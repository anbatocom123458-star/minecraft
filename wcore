            if res.returncode != 0:
                flash_err(f"Không thể tải model {selected_model}. Vui lòng kiểm tra lại tên model!")
                return
        except Exception as e:
            flash_err(f"Lỗi khi tải model: {e}")
            return

    CURRENT_MODEL = selected_model
    flash_ok(f"Đã chuyển thành công sang model: [bold {C_PURPLE}]{CURRENT_MODEL}[/bold {C_PURPLE}]")


# ─── LOCAL AI ENGINE (CHUẨN SỬA LỖI 404 & THINKING) ───
def call_ollama_ai(prompt: str, model=CURRENT_MODEL) -> str:
    url = f"{OLLAMA_BASE_URL}/api/chat"
    payload = {
        "model": model,
        "messages": [
            {"role": "user", "content": prompt}
        ],
        "stream": False
    }
    
    data = json.dumps(payload).encode('utf-8')
    req = urllib.request.Request(url, data=data, headers={'Content-Type': 'application/json'})
    
    try:
        with console.status(f"[bold {C_PURPLE}]🧠 [{model}] Đang suy nghĩ (Thinking)...[/bold {C_PURPLE}]", spinner="dots12"):
            with urllib.request.urlopen(req, timeout=120) as response:
                res_json = json.loads(response.read().decode('utf-8'))
                msg = res_json.get("message", {}).get("content", "")
                if not msg:
                    msg = res_json.get("response", "Không nhận được phản hồi từ AI.")
                return msg
    except urllib.error.HTTPError as e:
        if e.code == 404:
            return f"[LỖI 404]: Model '{model}' chưa được cài đặt trong Ollama. Hãy gõ lệnh 'đổi model' để tải về."
        return f"[LỖI AI HTTP {e.code}]: Ollama không xử lý được request. Kiểm tra lại model {model}."
    except Exception as e:
        return f"[LỖI KẾT NỐI AI]: Không thể gọi Ollama. Bạn đã chạy 'ollama serve' chưa?\nChi tiết: {e}"


# ─── INTENT PARSER ───
def parse_and_execute_intent(user_inp: str):
    inp = user_inp.strip()
    low = inp.lower()

    if low in ('exit', 'quit', 'thoát', 'dừng', '/exit'):
        console.print(f"\n[bold {C_ORANGE}]👋 Cảm ơn bạn đã sử dụng wcore Engine![/bold {C_ORANGE}]")
        sys.exit(0)

    if low in ('clear', 'xoá màn hình', 'xóa màn hình', '/clear', 'cls'):
        render_welcome()
        return

    # Chức năng đổi model
    if low in ('đổi model', 'doi model', 'model', 'change model', '/model'):
        change_model_menu()
        return

    # Xem/Đọc file
    read_keywords = ['xem file', 'đọc file', 'kiểm tra file', 'mở file', 'cat ', 'read ', '/read ']
    for kw in read_keywords:
        if low.startswith(kw):
            cmd_read(inp[len(kw):].strip())
            return

    # Chạy Shell
    run_keywords = ['chạy lệnh', 'thực thi', 'chạy ', 'run ', 'exec ', '/run ']
    for kw in run_keywords:
        if low.startswith(kw):
            cmd_run(inp[len(kw):].strip())
            return

    # Xem thư mục
    if low in ('ls', 'dir', 'danh sách', 'xem thư mục', 'kiểm tra thư mục', '/ls'):
        cmd_ls('')
        return

    # Xóa File
    rm_keywords = ['xoá file', 'xóa file', 'xoá ', 'xóa ', 'rm ', '/rm ']
    for kw in rm_keywords:
        if low.startswith(kw):
            cmd_rm(inp[len(kw):].strip())
            return

    # Trợ giúp
    if low in ('help', 'trợ giúp', 'hướng dẫn', '/help'):
        cmd_help()
        return

    # Gọi AI Local suy nghĩ & trả lời
    ai_reply = call_ollama_ai(inp, model=CURRENT_MODEL)

    console.print(Panel(
        ai_reply, 
        title=f"[bold {C_PURPLE}]🤖 Local AI ({CURRENT_MODEL})[/bold {C_PURPLE}]", 
        border_style=C_PURPLE, 
        box=ROUNDED
    ))


# ─── COMMAND HANDLERS ───
def cmd_read(arg):
    if not arg:
        flash_err("Cú pháp: xem file <tên_file>")
        return
    p = Path(arg).expanduser()
    if not p.is_absolute():
        p = Path(CWD) / p
    if not p.exists():
        flash_err(f"Không tìm thấy file: {p}")
        return
    try:
        text = p.read_text(encoding='utf-8', errors='replace')
        ext = p.suffix.lower().replace('.', '') or 'text'
        syntax = Syntax(text, ext, theme="monokai", line_numbers=True)
        console.print(Panel(syntax, title=f"📄 {p.name}", border_style=C_BLUE, box=ROUNDED))
    except Exception as e:
        flash_err(f"Lỗi đọc file: {e}")


def cmd_run(arg):
    if not arg:
        flash_err("Cú pháp: chạy <lệnh_shell>")
        return
    console.print(Rule(f"[bold {C_ORANGE}]▶ RUNNING[/bold {C_ORANGE}]", style=C_ORANGE2))
    try:
        proc = subprocess.run(arg, shell=True, cwd=CWD, capture_output=True, text=True, timeout=120)
        if proc.stdout:
            console.print(Panel(proc.stdout.rstrip(), title="stdout", border_style=C_GREEN, box=ROUNDED))
        if proc.stderr:
            console.print(Panel(proc.stderr.rstrip(), title="stderr", border_style=C_RED, box=ROUNDED))
        if proc.returncode == 0:
            flash_ok("Thực thi thành công")
        else:
            flash_err(f"Mã lỗi exit code {proc.returncode}")
    except Exception as e:
        flash_err(f"Lỗi: {e}")


def cmd_ls(arg):
    target = Path(arg) if arg else Path(CWD)
    if not target.exists():
        flash_err(f"Không tìm thấy: {target}")
        return
    tree = Tree(f"[bold {C_ORANGE}]📁 {target.name}[/bold {C_ORANGE}]")
    try:
        for p in sorted(target.iterdir()):
            if p.name.startswith('.'):
                continue
            if p.is_dir():
                tree.add(f"[bold {C_BLUE}]📁 {p.name}[/bold {C_BLUE}]")
            else:
                tree.add(f"[white]📄 {p.name}[/white]")
        console.print(Panel(tree, border_style=C_ORANGE2, box=ROUNDED))
    except Exception as e:
        flash_err(f"Lỗi: {e}")


def cmd_rm(arg):
    if not arg:
        flash_err("Cú pháp: xoá file <tên_file>")
        return
    p = Path(arg)
    if not p.exists():
        flash_err(f"Không thấy: {p}")
        return
    try:
        if p.is_dir():
            shutil.rmtree(p)
        else:
            p.unlink()
        flash_ok(f"Đã xoá {p}")
    except Exception as e:
        flash_err(f"Lỗi xoá: {e}")


