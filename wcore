def render_logo_frame(frame, width=90):
    """Logo với hiệu ứng gradient wave chạy theo frame."""
    t = Text()
    lines = LOGO.split('\n')
    max_line_len = max(len(l) for l in lines)
    pad = max(0, (width - max_line_len) // 2)
    for li, line in enumerate(lines):
        color = GRADIENT[(frame + li) % len(GRADIENT)]
        t.append(" " * pad + line, style=Style(color=color, bold=True))
        t.append('\n')
    sub_pad = max(0, (width - len(SUBTITLE)) // 2)
    t.append(" " * sub_pad + f"{SUBTITLE}\n", style=Style(color=C_GRAY, dim=True))
    return t


