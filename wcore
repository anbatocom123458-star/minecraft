# ─── METEOR RAINBOW ANIMATION ENGINE ───
class MeteorRainbowField:
    def __init__(self, w=80, h=3):
        self.w, self.h = w, h
        self.stars = []
        for _ in range(22):
            self.stars.append({
                'x': random.randint(0, w - 1),
                'y': random.uniform(0, h - 1),
                'c': random.choice(['·', '•', '*', '✦', '✧', '★']),
                's': random.uniform(0.15, 0.4),
                'col': random.choice(RAINBOW_COLORS),
            })
        self.meteor_x = -5
        self.meteor_y = random.randint(0, self.h - 1)

    def tick(self):
        for s in self.stars:
            s['y'] += s['s']
            if s['y'] >= self.h:
                s['y'] = 0
                s['x'] = random.randint(0, self.w - 1)
        
        self.meteor_x += 3
        if self.meteor_x > self.w + 12:
            self.meteor_x = -5
            self.meteor_y = random.randint(0, self.h - 1)

    def render(self):
        grid = [[' ' for _ in range(self.w)] for _ in range(self.h)]
        cols = [[None for _ in range(self.w)] for _ in range(self.h)]

        for s in self.stars:
            y, x = int(s['y']), int(s['x'])
            if 0 <= y < self.h and 0 <= x < self.w:
                grid[y][x] = s['c']
                cols[y][x] = s['col']

        mx, my = int(self.meteor_x), int(self.meteor_y)
        rainbow_trail = [('#ff4444', '☄'), ('#ffaa00', '≡'), ('#ffcc00', '-'), ('#4ade80', '·')]
        for i, (color, char) in enumerate(rainbow_trail):
            tx = mx - i
            if 0 <= my < self.h and 0 <= tx < self.w:
                grid[my][tx] = char
                cols[my][tx] = color

        lines = []
        for y in range(self.h):
            t = Text()
            for x in range(self.w):
                t.append(grid[y][x], style=cols[y][x] or C_BG)
            lines.append(t)
        return lines


