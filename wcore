# ─── ROOT EXECUTION TỰ ĐỘNG ───
def execute_root_ai_actions(ai_response: str):
    in_code_block, current_code, current_lang, target_filename = False, [], "python", "auto_script.py"
    for line in ai_response.split('\n'):
        if line.startswith("```"):
            if in_code_block:
                in_code_block = False
                execute_extracted_payload(current_lang, "\n".join(current_code), target_filename)
                current_code = []
            else:
                in_code_block = True
                parts = line.strip("`").split()
                current_lang = parts[0] if parts else "python"
                if len(parts) > 1: target_filename = parts[1]
            continue
        if in_code_block: current_code.append(line)

def execute_extracted_payload(lang: str, code: str, filename: str):
    console.print(f"\n[bold yellow]⚡ [ROOT AUTO-EXEC] Đang xử lý khối mã nguồn ({lang})...[/bold yellow]")
    if lang in ['python', 'sh', 'bash', 'html', 'javascript', 'txt', 'json']:
        filename = filename if filename != "auto_script.py" else f"root_output{'.py' if lang == 'python' else '.sh' if lang in ['sh','bash'] else '.txt'}"
        try:
            (Path(CWD) / filename).write_text(code, encoding='utf-8')
            flash_ok(f"Đã tạo file: {filename}")
        except Exception as e:
            return flash_err(f"Lỗi tạo file: {e}")

    if lang in ['python', 'sh', 'bash']:
        if console.input(f"[bold cyan]Quyền Root: Chạy lệnh file '{filename}' ngay không? (y/n): [/bold cyan]").strip().lower() == 'y':
            console.print(Rule(f"[bold {RAINBOW_COLORS[1]}]▶ ROOT EXECUTION RUNNING[/bold {RAINBOW_COLORS[1]}]"))
            proc = subprocess.run(f"python3 {filename}" if lang == 'python' else f"bash {filename}", shell=True, cwd=CWD, capture_output=True, text=True)
            if proc.stdout: console.print(Panel(proc.stdout.rstrip(), title="stdout", border_style=C_GREEN, box=ROUNDED))
            if proc.stderr: console.print(Panel(proc.stderr.rstrip(), title="stderr", border_style=C_RED, box=ROUNDED))


# ─── TỐI ƯU HÓA LUỒNG STREAMING & ĐO RAM ───
def call_ollama_stream(prompt: str):
    req = urllib.request.Request(
        f"{OLLAMA_LOCAL_URL}/api/chat",
        data=json.dumps({"model": CURRENT_MODEL, "messages": [{"role": "user", "content": prompt}], "stream": True}).encode('utf-8'),
        headers={'Content-Type': 'application/json'}
    )
    
    full_text, token_count = "", 0
    start_time = time.time()
    last_ui_update = 0
    last_ram_check = 0
    cached_ram = get_system_ram_usage()
    
    console.print(Rule(f"[bold {RAINBOW_COLORS[4]}]🤖 Local AI ({CURRENT_MODEL})[/bold {RAINBOW_COLORS[4]}]"))

    try:
        # Timeout 300s để tránh văng khi load model 70B
        with urllib.request.urlopen(req, timeout=300) as response:
            with Live(console=console, refresh_per_second=20) as live:
                for line in response:
                    if not line: continue
                    chunk = json.loads(line.decode('utf-8')).get("message", {}).get("content", "")
                    full_text += chunk
                    token_count += max(1, len(chunk) // 3)
                    
                    now = time.time()
                    # Throttling cập nhật UI: Cứ 0.05s (20 FPS) mới parse lại Markdown 1 lần để chống giật lag CPU
                    if now - last_ui_update > 0.05:
                        if now - last_ram_check > 2.0: # Throttling đo RAM 2 giây 1 lần
                            cached_ram = get_system_ram_usage()
                            last_ram_check = now
                            
                        elapsed = max(0.001, now - start_time)
                        status = f"\n\n[dim cyan]⚡ {token_count} tokens │ ⏱️ {elapsed:.1f}s │ 🚀 {token_count/elapsed:.1f} t/s │ 🧠 RAM: {cached_ram}[/dim cyan]"
                        live.update(Panel(Markdown(full_text + status), border_style=RAINBOW_COLORS[4], box=ROUNDED))
                        last_ui_update = now

                # Cập nhật frame cuối cùng khi kết thúc stream
                elapsed = max(0.001, time.time() - start_time)
                status = f"\n\n[dim cyan]⚡ {token_count} tokens │ ⏱️ {elapsed:.1f}s │ 🚀 {token_count/elapsed:.1f} t/s │ 🧠 RAM: {cached_ram}[/dim cyan]"
                live.update(Panel(Markdown(full_text + status), border_style=RAINBOW_COLORS[4], box=ROUNDED))

        execute_root_ai_actions(full_text)
    except Exception as e:
        flash_err(f"Lỗi AI: {e}. (Hãy chắc chắn 'ollama serve' đang chạy)")


# ─── PARSER & COMMANDS ───
def parse_and_execute_intent(user_inp: str):
    low = user_inp.strip().lower()
    if low in ('exit', 'quit', 'thoát', 'cls', '/exit'): return sys.exit(0)
    if low in ('clear', 'xoá màn hình'): return render_welcome()
    if low in ('đổi model', 'model'): return change_model_menu()
    if low.startswith(('xem file ', 'cat ')): return cmd_read(user_inp.strip()[len(low.split()[0]):].strip())
    if low.startswith(('chạy lệnh ', 'run ')): return cmd_run(user_inp.strip()[len(low.split()[0]):].strip())
    if low in ('ls', 'dir', 'danh sách'): return cmd_ls('')
    if low.startswith(('xoá file ', 'rm ')): return cmd_rm(user_inp.strip()[len(low.split()[0]):].strip())
    call_ollama_stream(user_inp)

def cmd_read(arg):
    try: console.print(Panel(Syntax(Path(arg).read_text('utf-8'), Path(arg).suffix[1:] or 'text', theme="monokai", line_numbers=True), title=f"📄 {arg}", border_style=RAINBOW_COLORS[3], box=ROUNDED))
    except Exception as e: flash_err(str(e))

def cmd_run(arg):
    try: 
        p = subprocess.run(arg, shell=True, cwd=CWD, capture_output=True, text=True, timeout=120)
        if p.stdout: console.print(Panel(p.stdout.rstrip(), title="stdout", border_style=C_GREEN, box=ROUNDED))
        if p.stderr: console.print(Panel(p.stderr.rstrip(), title="stderr", border_style=C_RED, box=ROUNDED))
    except Exception as e: flash_err(str(e))

def cmd_ls(arg):
    try:
        t = Tree(f"[bold {RAINBOW_COLORS[2]}]📁 {CWD}[/bold {RAINBOW_COLORS[2]}]")
        for p in sorted(Path(CWD).iterdir()): t.add(f"[bold {RAINBOW_COLORS[4]}]📁 {p.name}[/bold {RAINBOW_COLORS[4]}]" if p.is_dir() else f"[white]📄 {p.name}[/white]")
        console.print(Panel(t, border_style=RAINBOW_COLORS[3], box=ROUNDED))
    except Exception as e: flash_err(str(e))

def cmd_rm(arg):
    try:
        p = Path(arg)
        shutil.rmtree(p) if p.is_dir() else p.unlink()
        flash_ok(f"Đã xoá {p}")
    except Exception as e: flash_err(str(e))

def main():
    ensure_environment()
    render_welcome()
    while True:
        try:
            inp = console.input(f"[bold {RAINBOW_COLORS[1]}]👤 {os.path.basename(CWD)} ❯ [/bold {RAINBOW_COLORS[1]}]").strip()
            if inp: parse_and_execute_intent(inp); console.print(f"[dim]{'─' * min(shutil.get_terminal_size().columns, 65)}[/dim]\n")
        except (KeyboardInterrupt, EOFError): break
    console.print(f"\n[bold {RAINBOW_COLORS[1]}]👋 Tạm biệt người quản trị![/bold {RAINBOW_COLORS[1]}]")

if __name__ == "__main__": main()
