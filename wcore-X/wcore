# --- BỘ TÙY CHỈNH THEME VÀ MÀU SẮC ANSI ---
COLOR_HEADER = "\033[1;36m"
COLOR_MENU = "\033[1;32m"
COLOR_USER = "\033[1;33m"
COLOR_BOT = "\033[1;35m"
COLOR_DIM = "\033[2m"
COLOR_RESET = "\033[0m"
COLOR_BORDER = "\033[38;5;39m"
COLOR_METRICS = "\033[38;5;214m"

class AnimationSpinner:
    def __init__(self, message="🤖 wcore-X đang suy nghĩ..."):
        self.message = message
        self.running = False
        self.thread = None
        self.spinner = itertools.cycle(["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"])

    def spin(self):
        while self.running:
            sys.stdout.write(f"\r{COLOR_BOT}{next(self.spinner)} {self.message}{COLOR_RESET}")
            sys.stdout.flush()
            time.sleep(0.08)
        sys.stdout.write("\r" + " " * (len(self.message) + 10) + "\r")

    def start(self):
        self.running = True
        self.thread = threading.Thread(target=self.spin)
        self.thread.start()

    def stop(self):
        self.running = False
        if self.thread:
            self.thread.join()

def estimate_tokens(text):
    # Ước tính token chuẩn xác cho mô hình code
    words = len(text.split())
    return int(words * 1.35) + 1

def draw_box(text, title="", border_color=COLOR_BORDER):
    lines = text.split("\n")
    max_len = max(len(l) for l in lines) if lines else 40
    max_len = max(max_len, len(title) + 4, 50)
    
    top = f"{border_color}╭─ {title} " + "─" * (max_len - len(title) - 1) + f"╮{COLOR_RESET}"
    bottom = f"{border_color}╰" + "─" * (max_len + 2) + f"╯{COLOR_RESET}"
    
    print(top)
    for line in lines:
        pad = " " * (max_len - len(line))
        print(f"{border_color}│{COLOR_RESET} {line}{pad} {border_color}│{COLOR_RESET}")
    print(bottom)

