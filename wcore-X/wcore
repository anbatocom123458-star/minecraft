        t.append('\n')
    t.append(f"\n{SUBTITLE}\n", style=Style(color=C_GRAY, dim=True))
    return Align.center(t)


def render_input_box():
    inner = Text()
    inner.append("│ ", style=C_ORANGE)
    inner.append("Type your message...  ", style=C_GRAY)
    inner.append("(prefix / for commands)", style=Style(color=C_DARKGRAY, dim=True))
    return Panel(inner, box=ROUNDED, border_style=C_ORANGE2, padding=(0, 2), height=3)


def render_shortcuts():
    pairs = [
        ("tab", "switch mode"),
        ("ctrl+p", "settings"),
        ("@", "attach file"),
        ("$", "subagent"),
        ("/", "commands"),
    ]
    cols = []
    for k, d in pairs:
        t = Text()
        t.append(f"{k} ", style=Style(color=C_ORANGE, bold=True))
        t.append(d, style=C_GRAY)
        cols.append(t)
    return Align.center(Columns(cols, equal=True, expand=True))


def render_tip():
    t = Text()
    t.append("● Tip ", style=Style(color=C_ORANGE, bold=True))
    t.append("Run /background to set a custom image as your terminal wallpaper", style=C_GRAY)
    return Align.center(t)


def render_response(reply, metrics, mode):
    mode_colors = {
        'chat': C_ORANGE,
        'debug': C_BLUE,
        'project': C_GREEN,
        'info': C_PURPLE,
    }
    color = mode_colors.get(mode, C_ORANGE)
    mode_labels = {
        'chat': '💬 CHAT',
        'debug': '🛠️ DEBUG',
        'project': '🚀 PROJECT',
        'info': '📊 INFO',
    }
    label = mode_labels.get(mode, '🤖 wwcore-X')
    panel = Panel(
        reply,
        title=f"[bold {color}]{label} Response[/bold {color}]",
        border_style=color,
        box=ROUNDED,
        padding=(1, 2),
    )
    console.print()
    console.print(panel)
    console.print(f"  {metrics}")
    console.print(f"[dim]{'─' * 65}[/dim]\n")


def render_welcome():
    """Show animated intro then static screen."""
    tw = min(shutil.get_terminal_size().columns, 100)
    pf = ParticleField(w=tw, h=8, density=0.03)

    with Live(console=console, refresh_per_second=15, screen=False) as live:
        for _ in range(120):
            pf.tick()
            stars = pf.render()
            body = Text()
            for sl in stars[:4]:
                body.append(sl)
                body.append('\n')
            body.append(render_logo())
            for sl in stars[4:]:
                body.append(sl)
                body.append('\n')
            body.append('\n')
            body.append(Align.center(render_input_box()))
            body.append('\n')
            body.append(render_shortcuts())
            body.append('\n')
            body.append(render_tip())
            live.update(body)
            time.sleep(0.07)

    # Static fallback
    console.print(render_logo())
    console.print(Align.center(render_input_box()))
    console.print()
    console.print(render_shortcuts())
    console.print()
    console.print(render_tip())


