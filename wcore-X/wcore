def handle_command(cmd: str):
    c = cmd.lower().strip()
    if c in ('/exit', '/quit'):
        console.print(f"\n[bold {C_ORANGE}]👋 Cảm ơn bạn đã sử dụng wwcore-X![/bold {C_ORANGE}]")
        sys.exit(0)
    elif c == '/clear':
        console.clear()
        return 'clear'
    elif c == '/help':
        tbl = Table(show_header=False, box=ROUNDED, border_style=C_ORANGE)
        tbl.add_column("Lệnh", style=f"bold {C_ORANGE}")
        tbl.add_column("Mô tả", style=C_WHITE)
        for k, v in COMMANDS.items():
            tbl.add_row(k, v)
        console.print(Panel(tbl, title="[bold]📖 DANH SÁCH LỆNH[/bold]", border_style=C_ORANGE))
        return 'help'
    elif c == '/info':
        info = (
            f"[bold {C_ORANGE}]MODEL:[/bold {C_ORANGE}]      wwcore-X (Custom Qwen 2.5 Coder 3B)\n"
            f"[bold {C_ORANGE}]DEVELOPER:[/bold {C_ORANGE}]  Wstudio\n"
            f"[bold {C_ORANGE}]KHỞI TẠO:[/bold {C_ORANGE}]   27/06/2026\n"
            f"[bold {C_ORANGE}]OPTIMIZE:[/bold {C_ORANGE}]   Quantized Q4_K_M (4GB RAM Ready)\n"
            f"[bold {C_ORANGE}]INTERFACE:[/bold {C_ORANGE}]  Wstudio TUI Frame Engine v4.5\n"
            f"[bold {C_ORANGE}]MODE:[/bold {C_ORANGE}]       Unified (auto-detect + slash commands)"
        )
        console.print(Panel(info, title="[bold]📊 THÔNG TIN[/bold]", border_style=C_ORANGE, box=ROUNDED))
        return 'info'
    return None


# ─── MAIN LOOP ───
def main():
    # Auto-start Ollama
    os.system("pgrep ollama > /dev/null || (OLLAMA_DEBUG=false OLLAMA_LOGS=false ollama serve >/dev/null 2>&1 &)")
    time.sleep(1)

    console.clear()
    render_welcome()

    # Print command hint once
    console.print(f"\n[dim]Gõ /help để xem danh sách lệnh. Gõ /exit để thoát.[/dim]\n")

    while True:
        try:
            user_inp = console.input(f"[bold {C_ORANGE}]👤 % user ❯ [/bold {C_ORANGE}]").strip()
            if not user_inp:
                continue

            # Slash commands
            if user_inp.startswith('/'):
                result = handle_command(user_inp)
                if result == 'clear':
                    render_welcome()
                continue

            # Detect mode
            mode = detect_mode(user_inp)

            # Optional: force mode via prefix like "debug: ..." or "project: ..."
            forced = None
            for prefix, m in [('debug:', 'debug'), ('project:', 'project'), ('chat:', 'chat')]:
                if user_inp.lower().startswith(prefix):
                    forced = m
                    user_inp = user_inp[len(prefix):].strip()
                    break
            if forced:
                mode = forced

            reply, metrics, used_mode = ask_ollama(user_inp, mode)
            render_response(reply, metrics, used_mode)

        except KeyboardInterrupt:
            console.print(f"\n[bold {C_ORANGE}]👋 Tạm biệt![/bold {C_ORANGE}]")
            break
        except EOFError:
            break


if __name__ == "__main__":
    main()
