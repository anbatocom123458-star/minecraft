# ─── PARTICLE SYSTEM ───
class ParticleField:
    def __init__(self, w=90, h=10, density=0.025):
        self.w, self.h = w, h
        self.stars = []
        for _ in range(int(w * h * density)):
            self.stars.append({
                'x': random.randint(0, w - 1),
                'y': random.uniform(0, h - 1),
                'c': random.choice(['·', '•', '*', '˖', '‧']),
                's': random.uniform(0.15, 0.5),
                'col': random.choice([C_GRAY, C_DARKGRAY, C_ORANGE2, C_WHITE]),
            })

    def tick(self):
        for s in self.stars:
            s['y'] += s['s']
            if s['y'] >= self.h:
                s['y'] = 0
                s['x'] = random.randint(0, self.w - 1)

    def render(self):
        grid = [[' ' for _ in range(self.w)] for _ in range(self.h)]
        cols = [[None for _ in range(self.w)] for _ in range(self.h)]
        for s in self.stars:
            y, x = int(s['y']), int(s['x'])
            if 0 <= y < self.h and 0 <= x < self.w:
                grid[y][x] = s['c']
                cols[y][x] = s['col']
        lines = []
        for y in range(self.h):
            t = Text()
            for x in range(self.w):
                t.append(grid[y][x], style=cols[y][x] or C_BG)
            lines.append(t)
        return lines


# ─── UTILS ───
def estimate_tokens(text):
    return int(len(text.split()) * 1.35) + 1


def detect_mode(prompt: str) -> str:
    """Auto-detect user intent from prompt text."""
    p = prompt.lower()
    # Debug / fix code
    if any(k in p for k in ['lỗi', 'bug', 'fix', 'sửa', 'debug', 'crash', 'exception', 'traceback',
                             'không chạy', 'sai', 'error', 'failed']):
        return 'debug'
    # Project generation
    if any(k in p for k in ['tạo project', 'tạo dự án', 'cấu trúc thư mục', 'scaffold',
                             'project structure', 'folder structure', 'init project',
                             'tạo app', 'tạo ứng dụng', 'generate project']):
        return 'project'
    # Info
    if any(k in p for k in ['thông tin', 'info', 'about', 'who are you', 'bạn là ai',
                             'model gì', 'phiên bản', 'version', 'stats']):
        return 'info'
    return 'chat'


def build_system_prompt(mode: str) -> str:
    base = "Bạn là wwcore-X, một AI assistant chuyên lập trình do Wstudio phát triển."
    if mode == 'debug':
        base += (
            " Hãy phân tích lỗi code một cách chi tiết, chỉ rõ nguyên nhân root cause, "
            "đưa ra giải pháp sửa tối ưu kèm code mẫu đã sửa."
        )
    elif mode == 'project':
        base += (
            " Hãy tạo cấu trúc thư mục project chi tiết, kèm mô tả từng file, "
            "các dependency cần thiết, và lệnh khởi tạo nếu có."
        )
    elif mode == 'info':
        base += " Hãy trả lờ ngắn gọn, chuyên nghiệp về bản thân bạn."
    else:
        base += " Hãy trả lờ chính xác, súc tích, code phải đầy đủ và chạy được."
    return base


def ask_ollama(prompt, mode="chat"):
    sys_prompt = build_system_prompt(mode)
    full = f"{sys_prompt}\n\nUser: {prompt}\n\nwwcore-X:"
    data = json.dumps({"model": "wwcore-x", "prompt": full, "stream": False}).encode("utf-8")
    req = urllib.request.Request(
        "http://localhost:11434/api/generate",
        data=data,
        headers={"Content-Type": "application/json"}
    )
    t0 = time.time()
    with console.status("[bold #ff6b35]🤖  wwcore-X đang suy nghĩ...[/bold #ff6b35]", spinner="dots"):
        try:
            with urllib.request.urlopen(req, timeout=120) as res:
                raw = json.loads(res.read().decode("utf-8"))
                reply = raw.get("response", "")
                elapsed = time.time() - t0
        except Exception as e:
            reply = f"[red]Lỗi kết nối Ollama: {e}[/red]"
            elapsed = 0.001

    in_tok = estimate_tokens(prompt)
    out_tok = estimate_tokens(reply)
    total = in_tok + out_tok
    tps = round(out_tok / elapsed, 1) if elapsed > 0 else 0
    cpu = min(95.0, round(25.0 + (out_tok / 10), 1))
    metrics = (
        f"[dim]⏱ {elapsed:.2f}s  │  🔤 In:{in_tok} Out:{out_tok} Σ:{total}  │  "
        f"⚡ {tps} tok/s  │  💻 {cpu}% CPU[/dim]"
    )
    return reply, metrics, mode


