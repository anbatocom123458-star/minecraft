def ask_ai(prompt, mode="chat"):
    sys_prompt = "Bạn là wcore-X do Wstudio tạo ra."
    if mode == "debug":
        sys_prompt += " Hãy phân tích lỗi code và đưa ra giải pháp sửa tối ưu."
    
    full_prompt = f"{sys_prompt}\nUser: {prompt}"
    data = json.dumps({"model": "wcore-x", "prompt": full_prompt, "stream": False}).encode("utf-8")
    req = urllib.request.Request(
        "http://localhost:11434/api/generate",
        data=data,
        headers={"Content-Type": "application/json"}
    )
    
    start_time = time.time()
    spinner = AnimationSpinner("wcore-X đang suy nghĩ & tính toán code...")
    spinner.start()
    
    try:
        with urllib.request.urlopen(req) as res:
            raw_response = json.loads(res.read().decode("utf-8"))
            reply = raw_response.get("response", "")
            elapsed = time.time() - start_time
    except Exception as e:
        reply = f"Lỗi kết nối Ollama: {e}"
        elapsed = 0.001
    finally:
        spinner.stop()

    in_tokens = estimate_tokens(prompt)
    out_tokens = estimate_tokens(reply)
    total_tokens = in_tokens + out_tokens
    tps = round(out_tokens / elapsed, 1) if elapsed > 0 else 0
    cpu_usage_est = min(95.0, round(25.0 + (out_tokens / 10), 1))

    metrics_str = (
        f"{COLOR_METRICS}⏱️ Thời gian: {elapsed:.2f}s | "
        f"🔤 Token Input: {in_tokens} | Output: {out_tokens} (Tổng: {total_tokens}) | "
        f"⚡ Tốc độ: {tps} tok/s | "
        f"💻 Tài nguyên: {cpu_usage_est}% CPU/RAM{COLOR_RESET}"
    )

    return reply, metrics_str

def chat_loop(mode="chat"):
    banner()
    title = "CHẾ ĐỘ CHAT LẬP TRÌNH" if mode == "chat" else "CHẾ ĐỘ DEBUG CODE"
    print(f"{COLOR_HEADER}>>> {title} (Gõ 'menu' để quay lại){COLOR_RESET}\n")
    
    while True:
        try:
            inp = input(f"{COLOR_USER}👤 % user ❯ {COLOR_RESET}").strip()
            if inp.lower() in ["menu", "back", "exit"]:
                break
            if not inp:
                continue

            reply, metrics = ask_ai(inp, mode)
            
            draw_box(reply, "🤖 wcore-X Response", COLOR_BOT)
            print(f"  {metrics}\n")
            print(f"{COLOR_DIM}" + "─"*65 + f"{COLOR_RESET}\n")
        except KeyboardInterrupt:
            break

